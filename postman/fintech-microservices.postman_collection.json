      "name": "01. Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {\r\n    pm.collectionVariables.set(\"adminToken\", pm.response.json().accessToken);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"admin\", \"password\": \"{{adminPassword}}\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{customerUrl}}/auth/login",
          "host": [
            "{{customerUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
